# 服务地址
HOST=127.0.0.1
PORT=3000

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=campus_trade_production

# 可在初始化或创建管理员前覆盖管理员账号与密码
# ADMIN_USERNAME=moya
# ADMIN_PASSWORD=

# 每个部署使用独立的随机签名密钥，长度至少 32 字节
# 生成命令：node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 前端地址，用于 CORS
WEB_ORIGIN=http://localhost:5173
